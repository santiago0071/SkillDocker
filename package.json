{
  "name": "skilldocker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "node tests/test-engine.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:desktop": "powershell -Command \"$env:PATH = ($env:USERPROFILE + '\\.cargo\\bin;') + $env:PATH; npm run tauri build; Stop-Process -Name 'SkillDocker' -Force -ErrorAction SilentlyContinue; Copy-Item 'src-tauri\\target\\release\\skilldocker.exe' (Join-Path ([Environment]::GetFolderPath('Desktop')) 'SkillDocker.exe') -Force\"",
    "desktop": "powershell -Command \"Start-Process 'C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe' -ArgumentList '--app=http://localhost:1420', '--window-size=1200,850'\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-global-shortcut": "^2.0.1",
    "@types/dompurify": "^3.0.5",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "lucide-react": "^0.475.0",
    "marked": "^18.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.12.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.1.0"
  }
}
